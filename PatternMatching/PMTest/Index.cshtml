@using System.Globalization
@model IEnumerable<TestDemoMVCCoreWebAPP.Controllers.Employee>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var indianCulture = new CultureInfo("en-IN");
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Role</th>
            <th>Salary</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.Id</td>
                <td>@employee.Name</td>
                <td>@employee.Type</td>
                <td>@employee.Salary.ToString("C0", indianCulture)</td> @* Formats as currency *@
            </tr>
        }
    </tbody>
</table>
