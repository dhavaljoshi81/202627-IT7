@using System.Globalization
@using TestDemoMVCCoreWebAPP.Controllers;
@model IEnumerable<Employee>

@{
    ViewData["Title"] = "Advanced Employee Search";
    var indianCulture = new CultureInfo("en-IN");
    var criteria = ViewBag.Criteria as EmployeeSearchCriteria ?? new EmployeeSearchCriteria();
}

<h2>Advanced Employee Search</h2>

<form method="get" asp-action="SearchIndex" class="card card-body bg-light mb-4">
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label">Name</label>
            <input type="text" name="Name" value="@criteria.Name" class="form-control" placeholder="Search name..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">Role</label>
            <select name="Type" class="form-control" asp-items="Html.GetEnumSelectList<EmployeeType>()">
                <option value="">-- All Roles --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Min Salary</label>
            <input type="number" name="MinSalary" value="@criteria.MinSalary" class="form-control" placeholder="Min" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Max Salary</label>
            <input type="number" name="MaxSalary" value="@criteria.MaxSalary" class="form-control" placeholder="Max" />
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="SearchIndex" class="btn btn-secondary">Reset</a>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Role</th>
            <th>Salary</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center text-muted">No employees found matching the criteria.</td>
            </tr>
        }
        else
        {
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.Id</td>
                    <td>@employee.Name</td>
                    <td>@employee.Type</td>
                    <td>@employee.Salary.ToString("C0", indianCulture)</td>
                </tr>
            }
        }
    </tbody>
</table>